//
// ssh_home — PLAN Step 1: the cell grid — the terminal's shared state. The VT
// emulator (Step 2) WRITES cells; `render_grid` READS them into a Canvas that is
// save_png'd (deterministic, headless golden tests) and, in the live app,
// uploaded to GL for display.
//
// Rendering is the CPU-Canvas path proven in Step 0: per cell, fill the bg rect
// and draw the glyph. (Per-cell draw_text is fine for the golden; a glyph atlas
// is the perf path for the live terminal, later.)
//
//   loft src/main.loft /abs/out.png [clear|ready|grid]
use graphics;

FONT = "../fonts/DejaVuSansMono.ttf";   // relative to the source dir (src/)
BG = 0xFF101820;                         // default background (0xAARRGGBB)
FG = 0xFFE8F0FF;                         // default foreground

ATTR_BOLD = 1;                           // SGR attribute bits (Step 2.3)
ATTR_UNDER = 2;
ATTR_REV = 4;

// A terminal cell: a glyph + fg/bg colours (0xAARRGGBB) + SGR attribute bits
// (bold / underline / reverse). The renderer resolves the attributes at draw time.
struct Cell {
  ch: character,
  fg: integer,
  bg: integer,
  attrs: integer = 0,
}

// A cols x rows grid (row-major) plus the font + cell metrics to rasterize it.
struct Grid {
  cols: integer,
  rows: integer,
  cell_w: integer,
  cell_h: integer,
  font: integer,
  size: float,
  cells: vector<Cell>,
}

// Build an all-blank grid sized to `cols` x `rows` at the font/size given.
pub fn make_grid(font: integer, size: float, cols: integer, rows: integer) -> Grid {
  g = Grid {
    cols: cols,
    rows: rows,
    cell_w: gl_measure_text(font, "M", size) as integer,   // monospace advance
    cell_h: gl_text_height(font, size),
    font: font,
    size: size,
  };
  g.cells = [for _ in 0..cols * rows { Cell { ch: ' ', fg: FG, bg: BG } }];
  g
}

// Write one cell (bounds-checked). `&g.cells` is a writable alias so the element
// write propagates back through the grid.
pub fn grid_put(g: Grid, c: integer, r: integer, ch: character, fg: integer, bg: integer, attrs: integer = 0) {
  if c >= 0 and c < g.cols and r >= 0 and r < g.rows {
    gc = &g.cells;
    gc[r * g.cols + c] = Cell { ch: ch, fg: fg, bg: bg, attrs: attrs };
  }
}

// Write a string left-to-right starting at (c, r).
pub fn grid_str(g: Grid, c: integer, r: integer, s: text, fg: integer, bg: integer) {
  ps_i = 0;
  for ps_ch in s {
    grid_put(g, c + ps_i, r, ps_ch, fg, bg);
    ps_i += 1;
  }
}

// Rasterize the grid into a Canvas: per cell, fill the bg then draw the glyph.
pub fn render_grid(g: const Grid) -> Canvas {
  cv = canvas(g.cols * g.cell_w, g.rows * g.cell_h, BG);
  rg_cells = g.cells;
  for rg_r in 0..g.rows {
    for rg_c in 0..g.cols {
      cell = rg_cells[rg_r * g.cols + rg_c] ?? Cell { ch: ' ', fg: FG, bg: BG };
      px = rg_c * g.cell_w;
      py = rg_r * g.cell_h;
      // resolve SGR attributes: reverse swaps fg/bg, bold brightens the fg.
      efg = cell.fg;
      ebg = cell.bg;
      if (cell.attrs & ATTR_REV) != 0 { efg = cell.bg; ebg = cell.fg; }
      if (cell.attrs & ATTR_BOLD) != 0 { efg = brighten(efg); }
      cv.fill_rect(px, py, g.cell_w, g.cell_h, ebg);
      if cell.ch != ' ' {
        cv.draw_text(g.font, "{cell.ch}", g.size, px, py, efg);
      }
      if (cell.attrs & ATTR_UNDER) != 0 {
        cv.fill_rect(px, py + g.cell_h - 2, g.cell_w, 1, efg);   // underline
      }
    }
  }
  cv
}

// A test pattern: a box border + text runs (one with a coloured background) —
// exercises glyphs, per-cell fg, and per-cell bg in one golden.
fn scene_grid(font: integer) -> Canvas {
  cols = 22;
  rows = 7;
  g = make_grid(font, 24.0, cols, rows);
  for bx in 0..cols {
    grid_put(g, bx, 0, '-', FG, BG);
    grid_put(g, bx, rows - 1, '-', FG, BG);
  }
  for by in 0..rows {
    grid_put(g, 0, by, '|', FG, BG);
    grid_put(g, cols - 1, by, '|', FG, BG);
  }
  grid_put(g, 0, 0, '+', FG, BG);
  grid_put(g, cols - 1, 0, '+', FG, BG);
  grid_put(g, 0, rows - 1, '+', FG, BG);
  grid_put(g, cols - 1, rows - 1, '+', FG, BG);
  grid_str(g, 3, 2, "ssh_home", 0xFF88E0FF, BG);
  grid_str(g, 3, 4, "READY", FG, 0xFF204830);   // fg + coloured cell run
  render_grid(g)
}

// --- Step 1.2: geometry (cols×rows from window ÷ cell) + DPI-aware default ---

// Monospace cell metrics for a font at a size.
pub fn cell_w_for(font: integer, size: float) -> integer { gl_measure_text(font, "M", size) as integer }
pub fn cell_h_for(font: integer, size: float) -> integer { gl_text_height(font, size) }

// How many whole cols × rows fit a `win_w` × `win_h` pixel window. Zero cell
// size (a failed font) yields 0×0 rather than a divide-by-zero.
pub fn grid_cols_rows(win_w: integer, win_h: integer, cell_w: integer, cell_h: integer) -> (integer, integer) {
  // `?? 0` discharges the fallible `/` — under @PLN25 DN1 a division is typed
  // `integer?` even behind the `> 0` guard, so returning it into the non-null
  // `(integer, integer)` needs an explicit discharge (the branch keeps 0×0).
  cols = if cell_w > 0 { win_w / cell_w ?? 0 } else { 0 };
  rows = if cell_h > 0 { win_h / cell_h ?? 0 } else { 0 };
  (cols, rows)
}

// DPI-aware default font size: a readable base scaled by display density. Phone
// screens are hard to read (DESIGN §1), so the base is generous; the live app
// passes the real display scale, headless tests pass 1.0.
pub fn default_font_size(dpi_scale: float) -> float {
  18.0 * dpi_scale
}

// A grid sized to fill a `win_w` × `win_h` window at the given font/size.
pub fn make_grid_for_window(font: integer, size: float, win_w: integer, win_h: integer) -> Grid {
  (fw_cols, fw_rows) = grid_cols_rows(win_w, win_h, cell_w_for(font, size), cell_h_for(font, size));
  make_grid(font, size, fw_cols, fw_rows)
}

// Fill a 320×240 window at `size`; the derived grid dims scale with the size, so
// two sizes give two goldens of different dimensions.
fn scene_fit(font: integer, size: float) -> Canvas {
  g = make_grid_for_window(font, size, 320, 240);
  grid_str(g, 0, 0, "cols={g.cols} rows={g.rows}", 0xFF88E0FF, BG);
  for ft_r in 1..g.rows {
    grid_str(g, 0, ft_r, "{ft_r}", FG, BG);
  }
  render_grid(g)
}

// --- Step 2.1: VT/ANSI emulator — text + C0 + DECAWM deferred wrap ---
//
// The emulator is a pure state machine: `term_feed` consumes a char stream and
// mutates a `Term` (cursor + current colours + the DECAWM latch + the shared
// Grid). The one load-bearing invariant is the DEFERRED WRAP: a glyph written in
// the last column does NOT push the cursor off-screen — it latches `wrap_next`,
// and the *next* printable consumes the latch (wrap→write). So exactly `cols`
// glyphs fill a row with no premature blank line; glyph cols+1 wraps. Every cursor
// move clears the latch, and `term_move` is the single chokepoint that guarantees
// it. (Input is `text` here; the SSH path decodes PTY bytes→chars before feeding —
// Step 4.)

struct Term {
  grid: Grid,
  cx: integer,             // cursor column (0-based)
  cy: integer,             // cursor row (0-based)
  fg: integer,             // current SGR foreground (0xAARRGGBB)
  bg: integer,             // current SGR background
  attrs: integer,          // current SGR attribute bits (ATTR_BOLD/UNDER/REV) (2.3)
  wrap_next: boolean,      // DECAWM deferred-wrap latch
  pstate: integer,         // escape parser state: 0=ground, 1=esc, 2=csi (2.2)
  params: vector<integer>, // CSI numeric parameters collected so far
  pcur: integer,           // the CSI parameter currently being accumulated
  top: integer,            // scroll-region top margin (0-based, inclusive) (2.4)
  bot: integer,            // scroll-region bottom margin (0-based, inclusive)
}

pub fn term_new(grid: Grid) -> Term {
  // params omitted → defaults to [] (a vector field is non-null, empty by default)
  Term { grid: grid, cx: 0, cy: 0, fg: FG, bg: BG, attrs: 0, wrap_next: false,
         pstate: 0, pcur: 0, top: 0, bot: grid.rows - 1 }
}

fn clampi(v: integer, lo: integer, hi: integer) -> integer {
  if v < lo { lo } else if v > hi { hi } else { v }
}

// The cursor chokepoint: every non-printing cursor move routes through here, so
// the DECAWM latch is cleared in exactly one place — no op can forget it.
pub fn term_move(t: Term, cx: integer, cy: integer) {
  t.cx = clampi(cx, 0, t.grid.cols - 1);
  t.cy = clampi(cy, 0, t.grid.rows - 1);
  t.wrap_next = false;
}

// Next 8-column tab stop (classic HT behaviour).
fn next_tab(cx: integer) -> integer {
  q = cx / 8 ?? 0;      // discharge the fallible `/` (DN1 types it `integer?`)
  (q + 1) * 8
}

// Scroll rows [top..bot] by `count`; up=true scrolls up (blanks at the bottom of
// the region), up=false scrolls down (blanks at the top). `count` is clamped to
// the region height. This is the one engine behind LF/IND/RI and IL/DL.
fn grid_scroll_region(g: Grid, top: integer, bot: integer, count: integer, up: boolean, blank: Cell) {
  h = bot - top + 1;
  if count < 1 or h < 1 { return; }
  cnt = if count > h { h } else { count };
  gc = &g.cells;
  cols = g.cols;
  if up {
    for r in top..(bot - cnt + 1) {                       // dest rows shift up
      for c in 0..cols { gc[r * cols + c] = gc[(r + cnt) * cols + c]; }
    }
    for r in (bot - cnt + 1)..(bot + 1) {                 // blank the bottom `cnt`
      for c in 0..cols { gc[r * cols + c] = blank; }
    }
  } else {
    for r in rev((top + cnt)..(bot + 1)) {                // dest rows shift down
      for c in 0..cols { gc[r * cols + c] = gc[(r - cnt) * cols + c]; }
    }
    for r in top..(top + cnt) {                           // blank the top `cnt`
      for c in 0..cols { gc[r * cols + c] = blank; }
    }
  }
}

fn blank_cell(t: const Term) -> Cell { Cell { ch: ' ', fg: t.fg, bg: t.bg } }

// LF / IND: move down one row within the scroll region, scrolling the region up if
// already at the bottom margin. Column is unchanged (raw PTY LF); CR resets it.
fn term_linefeed(t: Term) {
  if t.cy == t.bot {
    grid_scroll_region(t.grid, t.top, t.bot, 1, true, blank_cell(t));
  } else if t.cy < t.grid.rows - 1 {
    t.cy += 1;
  }
  t.wrap_next = false;
}

// RI (reverse index): move up one row, scrolling the region down at the top margin.
fn term_rev_index(t: Term) {
  if t.cy == t.top {
    grid_scroll_region(t.grid, t.top, t.bot, 1, false, blank_cell(t));
  } else if t.cy > 0 {
    t.cy -= 1;
  }
  t.wrap_next = false;
}

// IL — insert `count` blank lines at the cursor row (within the region); lines
// below shift down, any pushed past the bottom margin are lost. Cursor → col 0.
fn term_insert_lines(t: Term, count: integer) {
  if t.cy >= t.top and t.cy <= t.bot {
    grid_scroll_region(t.grid, t.cy, t.bot, count, false, blank_cell(t));
    t.cx = 0;
    t.wrap_next = false;
  }
}

// DL — delete `count` lines at the cursor row (within the region); lines below
// shift up, blanks appear at the bottom margin. Cursor → col 0.
fn term_delete_lines(t: Term, count: integer) {
  if t.cy >= t.top and t.cy <= t.bot {
    grid_scroll_region(t.grid, t.cy, t.bot, count, true, blank_cell(t));
    t.cx = 0;
    t.wrap_next = false;
  }
}

// DECSTBM — set the scroll region to rows [top..bot] (1-based params); an invalid
// region is ignored, and (origin mode off) the cursor homes to (0,0).
fn term_set_region(t: Term, params: vector<integer>) {
  top1 = params[0] ?? 1; if top1 < 1 { top1 = 1; }
  bot1 = params[1] ?? t.grid.rows;
  if bot1 < 1 or bot1 > t.grid.rows { bot1 = t.grid.rows; }
  if top1 < bot1 {
    t.top = top1 - 1;
    t.bot = bot1 - 1;
    term_move(t, 0, 0);
  }
}

// Print one glyph at the cursor, honouring the deferred wrap, then advance.
fn term_put_ch(t: Term, ch: character) {
  if t.wrap_next {
    t.cx = 0;
    term_linefeed(t);          // down (+scroll); clears wrap_next
  }
  grid_put(t.grid, t.cx, t.cy, ch, t.fg, t.bg, t.attrs);
  if t.cx >= t.grid.cols - 1 {
    t.wrap_next = true;        // at the right margin: latch instead of advancing
  } else {
    t.cx += 1;
  }
}

// --- Step 2.2: CSI escape sequences — cursor moves (CUU/D/F/B, CUP) + erase (ED/EL) ---

// Blank cells [c0..c1] (inclusive) on row r with the current bg. grid_put is
// bounds-checked, so a reversed or oversized range is harmless.
fn erase_line_seg(t: Term, c0: integer, c1: integer, r: integer) {
  for c in c0..=c1 { grid_put(t.grid, c, r, ' ', t.fg, t.bg); }
}

// ED — erase in display. 0: cursor→end of screen; 1: start→cursor; 2/3: all.
fn term_erase_display(t: Term, mode: integer) {
  last = t.grid.cols - 1;
  if mode == 2 or mode == 3 {
    for r in 0..t.grid.rows { erase_line_seg(t, 0, last, r); }
  } else if mode == 1 {
    for r in 0..t.cy { erase_line_seg(t, 0, last, r); }
    erase_line_seg(t, 0, t.cx, t.cy);
  } else {                                       // 0 (default)
    erase_line_seg(t, t.cx, last, t.cy);
    for r in t.cy + 1..t.grid.rows { erase_line_seg(t, 0, last, r); }
  }
}

// EL — erase in line. 0: cursor→end; 1: start→cursor; 2: whole line.
fn term_erase_line(t: Term, mode: integer) {
  last = t.grid.cols - 1;
  if mode == 1 { erase_line_seg(t, 0, t.cx, t.cy); }
  else if mode == 2 { erase_line_seg(t, 0, last, t.cy); }
  else { erase_line_seg(t, t.cx, last, t.cy); }  // 0 (default)
}

// --- Step 2.3: SGR (colours + attributes) ---

// Colours are packed 0xFFRRGGBB — graphics' `rgb(r,g,b)` (== `rgba(r,g,b,255)`)
// already produces exactly that, so we reuse it rather than redefine it.

// The 16 ANSI colours (standard 0-7, bright 8-15).
fn ansi16(n: integer) -> integer {
  pal = [0xFF000000, 0xFFCD0000, 0xFF00CD00, 0xFFCDCD00, 0xFF0000EE, 0xFFCD00CD, 0xFF00CDCD, 0xFFE5E5E5,
         0xFF7F7F7F, 0xFFFF0000, 0xFF00FF00, 0xFFFFFF00, 0xFF5C5CFF, 0xFFFF00FF, 0xFF00FFFF, 0xFFFFFFFF];
  pal[n] ?? 0xFFFFFFFF
}

// One axis of the 6x6x6 colour cube (0 → 0, else 55 + 40·v). (graphics owns `cube`
// as a 3D primitive, so this is `cube6`.)
fn cube6(v: integer) -> integer { if v == 0 { 0 } else { 55 + v * 40 } }

// Resolve an xterm 256-colour index to 0xFFRRGGBB.
fn color256(n: integer) -> integer {
  if n < 16 { return ansi16(n); }
  if n >= 232 { gy = 8 + (n - 232) * 10; return rgb(gy, gy, gy); }   // grayscale ramp
  i = n - 16;
  r6 = i / 36 ?? 0;
  g6 = (i / 6 ?? 0) % 6 ?? 0;
  b6 = i % 6 ?? 0;
  rgb(cube6(r6), cube6(g6), cube6(b6))
}

// Brighten a colour (bold): lift each channel toward white.
fn lift(v: integer) -> integer { w = v + 64; if w > 255 { 255 } else { w } }
fn brighten(c: integer) -> integer {
  rgb(lift((c >> 16) & 0xFF), lift((c >> 8) & 0xFF), lift(c & 0xFF))
}

// Apply an SGR sequence (`ESC [ … m`): update fg / bg / attribute bits. 38 / 48
// consume a colour spec (`5;n` = 256-colour, `2;r;g;b` = truecolor).
fn apply_sgr(t: Term, params: vector<integer>) {
  n = len(params);
  i = 0;
  while i < n {
    p = params[i] ?? 0;
    if p == 0 { t.fg = FG; t.bg = BG; t.attrs = 0; }
    else if p == 1 { t.attrs = t.attrs | ATTR_BOLD; }
    else if p == 4 { t.attrs = t.attrs | ATTR_UNDER; }
    else if p == 7 { t.attrs = t.attrs | ATTR_REV; }
    else if p == 22 { t.attrs = t.attrs & ~ATTR_BOLD; }
    else if p == 24 { t.attrs = t.attrs & ~ATTR_UNDER; }
    else if p == 27 { t.attrs = t.attrs & ~ATTR_REV; }
    else if p == 39 { t.fg = FG; }
    else if p == 49 { t.bg = BG; }
    else if p >= 30 and p <= 37 { t.fg = ansi16(p - 30); }
    else if p >= 40 and p <= 47 { t.bg = ansi16(p - 40); }
    else if p >= 90 and p <= 97 { t.fg = ansi16(p - 90 + 8); }
    else if p >= 100 and p <= 107 { t.bg = ansi16(p - 100 + 8); }
    else if p == 38 or p == 48 {
      mode = params[i + 1] ?? 0;
      if mode == 5 {
        col = color256(params[i + 2] ?? 0);
        if p == 38 { t.fg = col; } else { t.bg = col; }
        i = i + 2;
      } else if mode == 2 {
        col = rgb(params[i + 2] ?? 0, params[i + 3] ?? 0, params[i + 4] ?? 0);
        if p == 38 { t.fg = col; } else { t.bg = col; }
        i = i + 4;
      }
    }
    i = i + 1;
  }
}

// Dispatch a completed CSI `ESC [ params final`. Erase does NOT move the cursor;
// cursor moves route through `term_move` (which clears the DECAWM latch).
fn csi_dispatch(t: Term, final: character, params: vector<integer>) {
  f = final as integer;
  n = params[0] ?? 0;                            // first param (0 == absent/empty)
  step = if n < 1 { 1 } else { n };              // cursor moves treat 0/absent as 1
  if f == 0x41 { term_move(t, t.cx, t.cy - step); }        // 'A' CUU
  else if f == 0x42 { term_move(t, t.cx, t.cy + step); }   // 'B' CUD
  else if f == 0x43 { term_move(t, t.cx + step, t.cy); }   // 'C' CUF
  else if f == 0x44 { term_move(t, t.cx - step, t.cy); }   // 'D' CUB
  else if f == 0x48 or f == 0x66 {                          // 'H' CUP / 'f' HVP
    row = params[0] ?? 1; if row < 1 { row = 1; }
    col = params[1] ?? 1; if col < 1 { col = 1; }
    term_move(t, col - 1, row - 1);              // CSI params are 1-based
  }
  else if f == 0x4A { term_erase_display(t, n); }          // 'J' ED
  else if f == 0x4B { term_erase_line(t, n); }             // 'K' EL
  else if f == 0x4C { term_insert_lines(t, step); }        // 'L' IL
  else if f == 0x4D { term_delete_lines(t, step); }        // 'M' DL
  else if f == 0x6D { apply_sgr(t, params); }              // 'm' SGR
  else if f == 0x72 { term_set_region(t, params); }        // 'r' DECSTBM
  // unrecognized finals ignored (modes 'h'/'l' → 2.5)
}

// Feed a char stream through the escape parser: ground → C0/print, else an
// `ESC [ … final` CSI. Parser state lives on the Term, so a sequence may span
// feed chunks. (The SSH path decodes PTY bytes→chars before feeding — Step 4.)
pub fn term_feed(t: Term, s: text) {
  for fc in s {
    cp = fc as integer;
    if t.pstate == 0 {                                       // GROUND
      if cp == 0x1B { t.pstate = 1; }                        // ESC
      else if cp == 0x0A { term_linefeed(t); }               // LF
      else if cp == 0x0D { term_move(t, 0, t.cy); }          // CR
      else if cp == 0x08 { term_move(t, t.cx - 1, t.cy); }   // BS
      else if cp == 0x09 { term_move(t, next_tab(t.cx), t.cy); } // HT
      else if cp >= 0x20 { term_put_ch(t, fc); }             // printable
    } else if t.pstate == 1 {                                // after ESC
      if cp == 0x5B { t.pstate = 2; t.params = []; t.pcur = 0; }  // '[' → CSI
      else if cp == 0x44 { term_linefeed(t); t.pstate = 0; }      // ESC D = IND
      else if cp == 0x4D { term_rev_index(t); t.pstate = 0; }     // ESC M = RI
      else { t.pstate = 0; }                                 // other ESC seqs: later
    } else {                                                 // CSI: params → final
      if cp == 0x1B { t.pstate = 1; }                        // ESC aborts + restarts
      else if cp >= 0x30 and cp <= 0x39 { t.pcur = t.pcur * 10 + (cp - 0x30); }  // digit
      else if cp == 0x3B { t.params += [t.pcur]; t.pcur = 0; }                   // ';'
      else if cp >= 0x40 and cp <= 0x7E {                    // final byte
        t.params += [t.pcur];
        csi_dispatch(t, fc, t.params);
        t.pstate = 0;
      }
      // intermediates / private markers ('?') are ignored in 2.2
    }
  }
}

// A grid with no font metrics — for model tests that assert state without rendering.
fn make_grid_bare(cols: integer, rows: integer) -> Grid {
  g = Grid { cols: cols, rows: rows, cell_w: 0, cell_h: 0, font: -1, size: 0.0 };
  g.cells = [for _ in 0..cols * rows { Cell { ch: ' ', fg: FG, bg: BG } }];
  g
}

fn term_ch_at(t: const Term, c: integer, r: integer) -> character {
  cell = t.grid.cells[r * t.grid.cols + c] ?? Cell { ch: ' ', fg: FG, bg: BG };
  cell.ch
}

fn term_cell_at(t: const Term, c: integer, r: integer) -> Cell {
  t.grid.cells[r * t.grid.cols + c] ?? Cell { ch: ' ', fg: FG, bg: BG }
}

// A render golden: CRLF text + a tab + a line that DECAWM-wraps past the margin.
fn scene_vt(font: integer) -> Canvas {
  t = term_new(make_grid(font, 24.0, 22, 7));
  term_feed(t, "ssh_home vt\r\n");
  term_feed(t, "line two\r\n");
  term_feed(t, "tab:\tX\r\n");
  term_feed(t, "wrap: this line is wider than the grid");
  render_grid(t.grid)
}

// A CSI golden: clear (ED), then place text at absolute positions (CUP).
fn scene_vt2(font: integer) -> Canvas {
  esc = 27 as character;
  t = term_new(make_grid(font, 24.0, 20, 6));
  term_feed(t, "{esc}[2J");              // ED: clear the screen
  term_feed(t, "{esc}[1;1HCSI demo");    // CUP top-left
  term_feed(t, "{esc}[3;5Hrow3 col5");   // CUP to (col5,row3)
  term_feed(t, "{esc}[6;1Hbottom line"); // CUP bottom row
  render_grid(t.grid)
}

// An SGR golden: 16-colour fg, bold/underline/reverse, bright-on-bg, 256, truecolor.
fn scene_vt3(font: integer) -> Canvas {
  esc = 27 as character;
  t = term_new(make_grid(font, 24.0, 24, 8));
  term_feed(t, "{esc}[31mred {esc}[32mgreen {esc}[34mblue{esc}[0m\r\n");
  term_feed(t, "{esc}[1mbold {esc}[4munder {esc}[7mrev{esc}[0m\r\n");
  term_feed(t, "{esc}[93;44mbright on blue{esc}[0m\r\n");
  term_feed(t, "{esc}[38;5;208m256-orange{esc}[0m\r\n");
  term_feed(t, "{esc}[48;2;80;0;80mtruecolor bg{esc}[0m");
  render_grid(t.grid)
}

// A scroll-region golden: a static header, then feed 7 lines into a 6-row region
// so it scrolls while row 1 (the header) stays put (the tmux-status-bar pattern).
fn scene_vt4(font: integer) -> Canvas {
  esc = 27 as character;
  t = term_new(make_grid(font, 22.0, 18, 7));
  term_feed(t, "{esc}[1;1H== header ==");
  term_feed(t, "{esc}[2;7r{esc}[2;1H");   // region rows 2..7, cursor into it
  term_feed(t, "line 1\r\nline 2\r\nline 3\r\nline 4\r\nline 5\r\nline 6\r\nline 7");
  render_grid(t.grid)
}

fn render(scene_name: text) -> Canvas {
  if scene_name == "clear" {
    return canvas(256, 192, BG);
  }
  font = gl_load_font(FONT);
  if font < 0 {
    println("ssh_home: font load failed ({FONT})");
    return canvas(256, 192, BG);
  }
  if scene_name == "grid" {
    return scene_grid(font);
  }
  if scene_name == "fita" {
    return scene_fit(font, 20.0);
  }
  if scene_name == "fitb" {
    return scene_fit(font, 32.0);
  }
  if scene_name == "vt" {
    return scene_vt(font);
  }
  if scene_name == "vt2" {
    return scene_vt2(font);
  }
  if scene_name == "vt3" {
    return scene_vt3(font);
  }
  if scene_name == "vt4" {
    return scene_vt4(font);
  }
  // "ready": the Step 0 single-line text scene.
  cv = canvas(256, 192, BG);
  cv.draw_text(font, "READY", 40.0, 16, 72, FG);
  cv
}

fn main() {
  args = arguments();
  if len(args) == 0 {
    println("usage: main.loft <output.png> [clear|ready|grid]");
    return;
  }
  out = args[0] ?? "";
  scene_name = if len(args) > 1 { args[1] ?? "clear" } else { "clear" };

  // (U) geometry unit assertions — no image, just pass/fail.
  if scene_name == "geomtest" {
    (c1, r1) = grid_cols_rows(320, 240, 16, 32);
    assert(c1 == 20);              // 320/16
    assert(r1 == 7);               // 240/32 = 7.5 → 7
    (c2, r2) = grid_cols_rows(256, 192, 14, 28);
    assert(c2 == 18);              // 256/14 = 18.28 → 18
    assert(r2 == 6);               // 192/28 = 6.85 → 6
    (c3, r3) = grid_cols_rows(100, 100, 0, 0);
    assert(c3 == 0 and r3 == 0);   // zero cell size → no divide-by-zero
    println("geomtest: PASS");
    return;
  }

  // (U) VT emulator model assertions — feed char fixtures, assert cursor + cells.
  if scene_name == "vttest" {
    bs = 8 as character;   // BS (0x08); loft string literals have no `\b` escape

    // CRLF: LF moves down (keeps column), CR resets the column.
    t = term_new(make_grid_bare(10, 4));
    term_feed(t, "AB\r\nC");
    assert(term_ch_at(t, 0, 0) == 'A' and term_ch_at(t, 1, 0) == 'B');
    assert(term_ch_at(t, 0, 1) == 'C');
    assert(t.cx == 1 and t.cy == 1);

    // DECAWM deferred wrap on a 3-wide grid: last column fills, overflow wraps.
    t2 = term_new(make_grid_bare(3, 3));
    term_feed(t2, "ABCD");
    assert(term_ch_at(t2, 2, 0) == 'C');     // C fills the last column (no early wrap)
    assert(term_ch_at(t2, 0, 1) == 'D');     // D wraps to the next row
    assert(t2.cx == 1 and t2.cy == 1);

    // Exactly `cols` glyphs fill the row with the cursor latched (no newline yet).
    t3 = term_new(make_grid_bare(3, 3));
    term_feed(t3, "XYZ");
    assert(term_ch_at(t3, 2, 0) == 'Z' and t3.cy == 0);
    term_feed(t3, "W");
    assert(term_ch_at(t3, 0, 1) == 'W' and t3.cy == 1);

    // BS moves left; the next glyph overwrites.
    t4 = term_new(make_grid_bare(10, 2));
    term_feed(t4, "AB{bs}C");
    assert(term_ch_at(t4, 1, 0) == 'C' and t4.cx == 2);

    // HT advances to the next 8-column tab stop.
    t5 = term_new(make_grid_bare(20, 2));
    term_feed(t5, "A\tB");
    assert(term_ch_at(t5, 8, 0) == 'B');

    // LF on the bottom row scrolls the screen up.
    t6 = term_new(make_grid_bare(3, 2));
    term_feed(t6, "A\r\nB\r\nC");
    assert(term_ch_at(t6, 0, 0) == 'B');     // B scrolled up from row 1
    assert(term_ch_at(t6, 0, 1) == 'C');     // C on the new bottom row
    assert(t6.cy == 1);
    println("vttest: PASS");
    return;
  }

  // (U) CSI assertions — cursor moves (CUU/D/F/B, CUP) + erase (ED/EL).
  if scene_name == "vttest2" {
    esc = 27 as character;

    // CUP is 1-based → (col-1, row-1); a glyph then lands there and advances.
    t = term_new(make_grid_bare(10, 5));
    term_feed(t, "{esc}[3;5HX");
    assert(term_ch_at(t, 4, 2) == 'X');
    assert(t.cx == 5 and t.cy == 2);

    // CUP with no params homes to (0,0).
    t2 = term_new(make_grid_bare(10, 5));
    term_feed(t2, "abc{esc}[HZ");
    assert(term_ch_at(t2, 0, 0) == 'Z' and t2.cx == 1 and t2.cy == 0);

    // Relative moves: explicit n and default 1.
    t3 = term_new(make_grid_bare(10, 5));
    term_feed(t3, "{esc}[5;5H");   // → (4,4)
    term_feed(t3, "{esc}[2A");     // up 2   → (4,2)
    assert(t3.cx == 4 and t3.cy == 2);
    term_feed(t3, "{esc}[3D");     // back 3 → (1,2)
    assert(t3.cx == 1 and t3.cy == 2);
    term_feed(t3, "{esc}[B");      // down 1 → (1,3)
    assert(t3.cy == 3);
    term_feed(t3, "{esc}[2C");     // fwd 2  → (3,3)
    assert(t3.cx == 3);

    // Moves clamp at the edges (no wrap / scroll).
    t4 = term_new(make_grid_bare(4, 3));
    term_feed(t4, "{esc}[99;99H");
    assert(t4.cx == 3 and t4.cy == 2);
    term_feed(t4, "{esc}[99A");
    assert(t4.cy == 0);

    // EL mode 0 (cursor→end) and mode 1 (start→cursor).
    t5 = term_new(make_grid_bare(6, 2));
    term_feed(t5, "ABCDEF{esc}[1;3H{esc}[0K");
    assert(term_ch_at(t5, 1, 0) == 'B' and term_ch_at(t5, 2, 0) == ' ' and term_ch_at(t5, 5, 0) == ' ');
    t6 = term_new(make_grid_bare(6, 2));
    term_feed(t6, "ABCDEF{esc}[1;3H{esc}[1K");
    assert(term_ch_at(t6, 0, 0) == ' ' and term_ch_at(t6, 2, 0) == ' ' and term_ch_at(t6, 3, 0) == 'D');

    // ED mode 2 (whole screen).
    t7 = term_new(make_grid_bare(4, 3));
    term_feed(t7, "{esc}[2;2Hxy{esc}[2J");
    assert(term_ch_at(t7, 1, 1) == ' ' and term_ch_at(t7, 2, 1) == ' ');

    // ED mode 0 (cursor→end): keeps everything above/before the cursor.
    t8 = term_new(make_grid_bare(3, 3));
    term_feed(t8, "ABCDEFGHI{esc}[2;2H{esc}[0J");
    assert(term_ch_at(t8, 0, 0) == 'A' and term_ch_at(t8, 2, 0) == 'C');  // row 0 intact
    assert(term_ch_at(t8, 0, 1) == 'D');                                   // before cursor intact
    assert(term_ch_at(t8, 1, 1) == ' ' and term_ch_at(t8, 2, 1) == ' ');  // E,F erased
    assert(term_ch_at(t8, 0, 2) == ' ' and term_ch_at(t8, 2, 2) == ' ');  // row 2 erased
    println("vttest2: PASS");
    return;
  }

  // (U) SGR assertions — 16/256/truecolor fg+bg, bold/underline/reverse.
  if scene_name == "vttest3" {
    esc = 27 as character;

    // 16-colour fg + bg, then reset.
    t = term_new(make_grid_bare(10, 2));
    term_feed(t, "{esc}[31;42mX{esc}[0mY");
    cx0 = term_cell_at(t, 0, 0);
    assert(cx0.ch == 'X' and cx0.fg == ansi16(1) and cx0.bg == ansi16(2));
    cy0 = term_cell_at(t, 1, 0);
    assert(cy0.fg == FG and cy0.bg == BG and cy0.attrs == 0);

    // attribute bits set together, then clear bold only (underline stays).
    t2 = term_new(make_grid_bare(10, 2));
    term_feed(t2, "{esc}[1;4;7mZ{esc}[22mW");
    cz = term_cell_at(t2, 0, 0);
    assert((cz.attrs & ATTR_BOLD) != 0 and (cz.attrs & ATTR_UNDER) != 0 and (cz.attrs & ATTR_REV) != 0);
    cw = term_cell_at(t2, 1, 0);
    assert((cw.attrs & ATTR_BOLD) == 0 and (cw.attrs & ATTR_UNDER) != 0);

    // 256-colour fg (38;5;n) and truecolor bg (48;2;r;g;b).
    t3 = term_new(make_grid_bare(10, 2));
    term_feed(t3, "{esc}[38;5;208mA{esc}[48;2;10;20;30mB");
    assert(term_cell_at(t3, 0, 0).fg == color256(208));
    assert(term_cell_at(t3, 1, 0).bg == rgb(10, 20, 30));

    // bright fg (90-97) maps to the bright half of the palette.
    t4 = term_new(make_grid_bare(10, 2));
    term_feed(t4, "{esc}[92mG");
    assert(term_cell_at(t4, 0, 0).fg == ansi16(10));

    // default fg (39) resets colour but keeps attributes.
    t5 = term_new(make_grid_bare(10, 2));
    term_feed(t5, "{esc}[31;1m{esc}[39mQ");
    cq = term_cell_at(t5, 0, 0);
    assert(cq.fg == FG and (cq.attrs & ATTR_BOLD) != 0);
    println("vttest3: PASS");
    return;
  }

  // (U) scroll-region assertions — DECSTBM, IND/RI, IL/DL.
  if scene_name == "vttest4" {
    esc = 27 as character;
    seed = "{esc}[1;1HA{esc}[2;1HB{esc}[3;1HC{esc}[4;1HD{esc}[5;1HE";  // rows 0-4 col0

    // IND at the bottom margin scrolls ONLY the region [1..3]; rows 0 and 4 stay.
    t = term_new(make_grid_bare(3, 5));
    term_feed(t, "{seed}{esc}[2;4r{esc}[4;1H{esc}D");
    assert(term_ch_at(t, 0, 0) == 'A' and term_ch_at(t, 0, 4) == 'E');   // outside region
    assert(term_ch_at(t, 0, 1) == 'C' and term_ch_at(t, 0, 2) == 'D');   // B scrolled off
    assert(term_ch_at(t, 0, 3) == ' ');                                   // blank at region bottom

    // RI at the top margin scrolls the region down.
    t2 = term_new(make_grid_bare(3, 5));
    term_feed(t2, "{seed}{esc}[2;4r{esc}[2;1H{esc}M");
    assert(term_ch_at(t2, 0, 0) == 'A' and term_ch_at(t2, 0, 4) == 'E');
    assert(term_ch_at(t2, 0, 1) == ' ');
    assert(term_ch_at(t2, 0, 2) == 'B' and term_ch_at(t2, 0, 3) == 'C');

    // IL inserts a blank line at the cursor (default region); E pushed off.
    t3 = term_new(make_grid_bare(3, 5));
    term_feed(t3, "{seed}{esc}[2;1H{esc}[1L");
    assert(term_ch_at(t3, 0, 0) == 'A' and term_ch_at(t3, 0, 1) == ' ');
    assert(term_ch_at(t3, 0, 2) == 'B' and term_ch_at(t3, 0, 4) == 'D');

    // DL deletes the cursor line; the rest shift up, blank at the bottom.
    t4 = term_new(make_grid_bare(3, 5));
    term_feed(t4, "{seed}{esc}[2;1H{esc}[1M");
    assert(term_ch_at(t4, 0, 0) == 'A' and term_ch_at(t4, 0, 1) == 'C');
    assert(term_ch_at(t4, 0, 3) == 'E' and term_ch_at(t4, 0, 4) == ' ');

    // DECSTBM sets the 0-based region and homes the cursor.
    t5 = term_new(make_grid_bare(4, 6));
    term_feed(t5, "{esc}[3;5H{esc}[2;5r");
    assert(t5.cx == 0 and t5.cy == 0 and t5.top == 1 and t5.bot == 4);
    println("vttest4: PASS");
    return;
  }

  frame = render(scene_name);
  if frame.save_png(out) { println("ssh_home: wrote {out} (scene={scene_name})"); }
  else { println("ssh_home: save_png FAILED"); }
}
