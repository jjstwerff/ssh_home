//
// ssh_home — PLAN Step 1: the cell grid — the terminal's shared state. The VT
// emulator (Step 2) WRITES cells; `render_grid` READS them into a Canvas that is
// save_png'd (deterministic, headless golden tests) and, in the live app,
// uploaded to GL for display.
//
// Rendering is the CPU-Canvas path proven in Step 0: per cell, fill the bg rect
// and draw the glyph. (Per-cell draw_text is fine for the golden; a glyph atlas
// is the perf path for the live terminal, later.)
//
//   loft src/main.loft /abs/out.png [clear|ready|grid]
use graphics;

FONT = "../fonts/DejaVuSansMono.ttf";   // relative to the source dir (src/)
BG = 0xFF101820;                         // default background (0xAARRGGBB)
FG = 0xFFE8F0FF;                         // default foreground

// A terminal cell: a glyph + fg/bg colours. Attributes (bold, reverse, …) arrive
// with the SGR handling in Step 2.
struct Cell {
  ch: character,
  fg: integer,
  bg: integer,
}

// A cols x rows grid (row-major) plus the font + cell metrics to rasterize it.
struct Grid {
  cols: integer,
  rows: integer,
  cell_w: integer,
  cell_h: integer,
  font: integer,
  size: float,
  cells: vector<Cell>,
}

// Build an all-blank grid sized to `cols` x `rows` at the font/size given.
pub fn make_grid(font: integer, size: float, cols: integer, rows: integer) -> Grid {
  g = Grid {
    cols: cols,
    rows: rows,
    cell_w: gl_measure_text(font, "M", size) as integer,   // monospace advance
    cell_h: gl_text_height(font, size),
    font: font,
    size: size,
  };
  g.cells = [for _ in 0..cols * rows { Cell { ch: ' ', fg: FG, bg: BG } }];
  g
}

// Write one cell (bounds-checked). `&g.cells` is a writable alias so the element
// write propagates back through the grid.
pub fn grid_put(g: Grid, c: integer, r: integer, ch: character, fg: integer, bg: integer) {
  if c >= 0 and c < g.cols and r >= 0 and r < g.rows {
    gc = &g.cells;
    gc[r * g.cols + c] = Cell { ch: ch, fg: fg, bg: bg };
  }
}

// Write a string left-to-right starting at (c, r).
pub fn grid_str(g: Grid, c: integer, r: integer, s: text, fg: integer, bg: integer) {
  ps_i = 0;
  for ps_ch in s {
    grid_put(g, c + ps_i, r, ps_ch, fg, bg);
    ps_i += 1;
  }
}

// Rasterize the grid into a Canvas: per cell, fill the bg then draw the glyph.
pub fn render_grid(g: const Grid) -> Canvas {
  cv = canvas(g.cols * g.cell_w, g.rows * g.cell_h, BG);
  rg_cells = g.cells;
  for rg_r in 0..g.rows {
    for rg_c in 0..g.cols {
      cell = rg_cells[rg_r * g.cols + rg_c] ?? Cell { ch: ' ', fg: FG, bg: BG };
      px = rg_c * g.cell_w;
      py = rg_r * g.cell_h;
      cv.fill_rect(px, py, g.cell_w, g.cell_h, cell.bg);
      if cell.ch != ' ' {
        cv.draw_text(g.font, "{cell.ch}", g.size, px, py, cell.fg);
      }
    }
  }
  cv
}

// A test pattern: a box border + text runs (one with a coloured background) —
// exercises glyphs, per-cell fg, and per-cell bg in one golden.
fn scene_grid(font: integer) -> Canvas {
  cols = 22;
  rows = 7;
  g = make_grid(font, 24.0, cols, rows);
  for bx in 0..cols {
    grid_put(g, bx, 0, '-', FG, BG);
    grid_put(g, bx, rows - 1, '-', FG, BG);
  }
  for by in 0..rows {
    grid_put(g, 0, by, '|', FG, BG);
    grid_put(g, cols - 1, by, '|', FG, BG);
  }
  grid_put(g, 0, 0, '+', FG, BG);
  grid_put(g, cols - 1, 0, '+', FG, BG);
  grid_put(g, 0, rows - 1, '+', FG, BG);
  grid_put(g, cols - 1, rows - 1, '+', FG, BG);
  grid_str(g, 3, 2, "ssh_home", 0xFF88E0FF, BG);
  grid_str(g, 3, 4, "READY", FG, 0xFF204830);   // fg + coloured cell run
  render_grid(g)
}

// --- Step 1.2: geometry (cols×rows from window ÷ cell) + DPI-aware default ---

// Monospace cell metrics for a font at a size.
pub fn cell_w_for(font: integer, size: float) -> integer { gl_measure_text(font, "M", size) as integer }
pub fn cell_h_for(font: integer, size: float) -> integer { gl_text_height(font, size) }

// How many whole cols × rows fit a `win_w` × `win_h` pixel window. Zero cell
// size (a failed font) yields 0×0 rather than a divide-by-zero.
pub fn grid_cols_rows(win_w: integer, win_h: integer, cell_w: integer, cell_h: integer) -> (integer, integer) {
  cols = if cell_w > 0 { win_w / cell_w } else { 0 };
  rows = if cell_h > 0 { win_h / cell_h } else { 0 };
  (cols, rows)
}

// DPI-aware default font size: a readable base scaled by display density. Phone
// screens are hard to read (DESIGN §1), so the base is generous; the live app
// passes the real display scale, headless tests pass 1.0.
pub fn default_font_size(dpi_scale: float) -> float {
  18.0 * dpi_scale
}

// A grid sized to fill a `win_w` × `win_h` window at the given font/size.
pub fn make_grid_for_window(font: integer, size: float, win_w: integer, win_h: integer) -> Grid {
  (fw_cols, fw_rows) = grid_cols_rows(win_w, win_h, cell_w_for(font, size), cell_h_for(font, size));
  make_grid(font, size, fw_cols, fw_rows)
}

// Fill a 320×240 window at `size`; the derived grid dims scale with the size, so
// two sizes give two goldens of different dimensions.
fn scene_fit(font: integer, size: float) -> Canvas {
  g = make_grid_for_window(font, size, 320, 240);
  grid_str(g, 0, 0, "cols={g.cols} rows={g.rows}", 0xFF88E0FF, BG);
  for ft_r in 1..g.rows {
    grid_str(g, 0, ft_r, "{ft_r}", FG, BG);
  }
  render_grid(g)
}

fn render(scene_name: text) -> Canvas {
  if scene_name == "clear" {
    return canvas(256, 192, BG);
  }
  font = gl_load_font(FONT);
  if font < 0 {
    println("ssh_home: font load failed ({FONT})");
    return canvas(256, 192, BG);
  }
  if scene_name == "grid" {
    return scene_grid(font);
  }
  if scene_name == "fita" {
    return scene_fit(font, 20.0);
  }
  if scene_name == "fitb" {
    return scene_fit(font, 32.0);
  }
  // "ready": the Step 0 single-line text scene.
  cv = canvas(256, 192, BG);
  cv.draw_text(font, "READY", 40.0, 16, 72, FG);
  cv
}

fn main() {
  args = arguments();
  if len(args) == 0 {
    println("usage: main.loft <output.png> [clear|ready|grid]");
    return;
  }
  out = args[0] ?? "";
  scene_name = if len(args) > 1 { args[1] ?? "clear" } else { "clear" };

  // (U) geometry unit assertions — no image, just pass/fail.
  if scene_name == "geomtest" {
    (c1, r1) = grid_cols_rows(320, 240, 16, 32);
    assert(c1 == 20);              // 320/16
    assert(r1 == 7);               // 240/32 = 7.5 → 7
    (c2, r2) = grid_cols_rows(256, 192, 14, 28);
    assert(c2 == 18);              // 256/14 = 18.28 → 18
    assert(r2 == 6);               // 192/28 = 6.85 → 6
    (c3, r3) = grid_cols_rows(100, 100, 0, 0);
    assert(c3 == 0 and r3 == 0);   // zero cell size → no divide-by-zero
    println("geomtest: PASS");
    return;
  }

  frame = render(scene_name);
  if frame.save_png(out) { println("ssh_home: wrote {out} (scene={scene_name})"); }
  else { println("ssh_home: save_png FAILED"); }
}
