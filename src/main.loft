//
// ssh_home — PLAN Step 0: the golden-capture harness + the text primitive the
// VT emulator will sit on.
//
// Renders the frame into a CPU `Canvas` and `save_png`s it — deterministic
// (fontdue/CPU raster, no GPU AA variance) and HEADLESS (no GL window, so goldens
// need no display and don't hit the --native winit panic). This is the render
// path the terminal grid will grow into; the live app will additionally upload
// the same Canvas to GL for interactive display (Step 1+).
//
// Arg 1 = output PNG (absolute → written verbatim). Arg 2 = scene: clear | ready.
//
//   loft src/main.loft /abs/out.png ready
use graphics;

W = 256;
H = 192;
FONT = "../fonts/DejaVuSansMono.ttf";   // relative to the source dir (src/)

// Render one frame into a Canvas. Colours are 0xAARRGGBB (the Canvas convention).
pub fn render(scene_name: text) -> Canvas {
  cv = canvas(W, H, 0xFF101820);        // opaque dark slate
  if scene_name == "clear" { return cv; }
  font = gl_load_font(FONT);            // fontdue/CPU — no GL context needed
  if font < 0 {
    println("ssh_home: font load failed ({FONT})");
    return cv;
  }
  cv.draw_text(font, "READY", 40.0, 16, 72, 0xFFE8F0FF);   // near-white
  cv
}

fn main() {
  args = arguments();
  if len(args) == 0 {
    println("usage: main.loft <output.png> [clear|ready]");
    return;
  }
  out = args[0] ?? "";
  scene_name = if len(args) > 1 { args[1] ?? "clear" } else { "clear" };
  frame = render(scene_name);
  if frame.save_png(out) { println("ssh_home 0.3: wrote {out} (scene={scene_name})"); }
  else { println("ssh_home 0.3: save_png FAILED"); }
}
